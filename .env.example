# Shared password Matt types on the /studio login form
ADMIN_PASSWORD=
# Long random string — HMAC key for the admin session cookie
ADMIN_SESSION_SECRET=
# Fine-grained PAT with contents:read/write scoped to this repo only
GITHUB_TOKEN=
# GitHub account or org that owns the deploy repo
GITHUB_OWNER=
# Repo name on GitHub (without the owner prefix)
GITHUB_REPO=
# Deploy branch that Vercel watches — typically main
GITHUB_BRANCH=
# GA4 Measurement ID (G-XXXXXXXXXX) — leave blank to disable analytics
PUBLIC_GA_ID=
# Resend API key for contact form sends (re_...)
RESEND_API_KEY=
# Optional override for the From header — defaults to "The Drawing Office <info@thedrawingoffice.com>"
# Must be on a domain you've verified in Resend
RESEND_FROM=
