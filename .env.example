# Sanity project ID — exposed to the browser via SvelteKit's PUBLIC_ prefix
PUBLIC_SANITY_PROJECT_ID=
# Dataset name — usually "production"
PUBLIC_SANITY_DATASET=production
# Write token for the seed script (Editor or higher). Create at https://www.sanity.io/manage
# Only needed locally for `bun run sanity:seed` — leave blank in deployed envs.
SANITY_WRITE_TOKEN=

# GA4 Measurement ID (G-XXXXXXXXXX) — leave blank to disable analytics
PUBLIC_GA_ID=

# Resend API key for contact form sends (re_...)
RESEND_API_KEY=
# Optional override for the From header — defaults to "The Drawing Office <info@thedrawingoffice.com>"
# Must be on a domain you've verified in Resend
RESEND_FROM=
